CHIP NonP16 {
    IN in[16];
    OUT out;

    PARTS:
        Xor(a = in[0],  b = in[1],  out = xor1);
        Xor(a = in[2],  b = in[3],  out = xor2);
        Xor(a = in[4],  b = in[5],  out = xor3);
        Xor(a = in[6],  b = in[7],  out = xor4);
        Xor(a = in[8],  b = in[9],  out = xor5);
        Xor(a = in[10], b = in[11], out = xor6);
        Xor(a = in[12], b = in[13], out = xor7);
        Xor(a = in[14], b = in[15], out = xor8);
        Xor(a = xor1,   b = xor2,   out = xor9);
        Xor(a = xor3,   b = xor4,   out = xor10);
        Xor(a = xor5,   b = xor6,   out = xor11);
        Xor(a = xor7,   b = xor8,   out = xor12);
        Xor(a = xor9,   b = xor10,  out = xor13);
        Xor(a = xor11,  b = xor12,  out = xor14);
        Xor(a = xor13,  b = xor14,  out = out);
}