CHIP Adder3bit {
    IN a[3], b[3];
    OUT sum[3], carry;

    PARTS:
        HalfAdder(a = a[0], b = b[0], sum = sum[0], carry = carry1);
        FullAdder(a = a[1], b = b[1], c = carry1, sum = sum[1], carry = carry2);
        FullAdder(a = a[2], b = b[2], c = carry2, sum = sum[2], carry = carry);
}