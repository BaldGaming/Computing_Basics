CHIP CountNegEvenGroups {
    IN in[16];
    OUT count[3];

    PARTS:
        IsNegEven4(a = in[0..3],   out = out1);
        IsNegEven4(a = in[4..7],   out = out2);
        IsNegEven4(a = in[8..11],  out = out3);
        IsNegEven4(a = in[12..15], out = out4);

        HalfAdder(a = out1, b = out2, sum = s1, carry = c1);
        HalfAdder(a = out3, b = out4, sum = s2, carry = c2);
        HalfAdder(a = s1, b = s2, sum = s3, carry = c3);

        FullAdder(a = c1, b = c2, c = c3, sum = count[1], carry = count[2]);

        Not(in = s3, out = nots3);
        Not(in = nots3, out = count[0]);
}